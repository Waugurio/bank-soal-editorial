#include <iostream>
using namespace std;
long long b,c,d,target,kemungkinan = 0;

int main() {
    cin >> b >> c >> d;
    target = c-d;

    for (long long i = 1; i*i <= target; i++) {
        if (target%i==0) {
            long long faktorkedua = target/i;
            if(faktorkedua==i) {
                if (i>d && i<=b) kemungkinan++;
            } else {
                if(i>d && i<=b) kemungkinan++;
                if(faktorkedua>d && faktorkedua<=b) kemungkinan++;
            }
        }
    }
    if(c==d && b>d) kemungkinan = b-d;
    if(c<d) kemungkinan = 0;

    cout << kemungkinan;
    return 0;
}