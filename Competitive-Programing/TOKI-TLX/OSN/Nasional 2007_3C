#include <bits/stdc++.h>
typedef long long ll;
using namespace std;

int main() {
    ll bebek,kucing; cin >> bebek >> kucing;
    ll selisih = kucing - bebek;

    for (ll i = 60; i >= 0; i--) {
        ll n = pow(2,i);
        if (n <= selisih) {
            selisih -= n;
            cout << n << '\n';
        }
    }
    return 0;
}